# MineCMS playground — переменные окружения для server.

# --- Системные ---
SESSION_SECRET=replace-me-with-32-chars-minimum-secret
HOST=127.0.0.1
PORT=3333
LOG_LEVEL=info

# --- База данных ---
# Драйвер playground — PostgreSQL 16 (см. ../docker-compose.yml).
DATABASE_DRIVER=postgres
DATABASE_URL=postgres://minecms:minecms@127.0.0.1:5432/minecms

# --- Schemas-as-code ---
# Путь к minecms.config.ts. Server использует его, чтобы динамически построить
# таблицы и CRUD по пользовательским схемам.
MINECMS_CONFIG=./minecms.config.ts

# Применять диффы схем при старте сервера. true по умолчанию.
MINECMS_AUTO_MIGRATE=true

# Разрешить деструктивные миграции (DROP/RENAME колонок, ADD UNIQUE на существующих
# данных). По умолчанию false — сервер при `false` всё равно применит безопасные
# CREATE TABLE и ADD COLUMN nullable, а опасные пропустит и сообщит в логе.
MINECMS_ALLOW_DATA_LOSS=false

# --- Медиа-хранилище (Phase 13) ---
# S3-совместимое хранилище. Локально — MinIO из ../docker-compose.yml.
# В production достаточно поменять переменные на ваш AWS S3 / Cloudflare R2 / Backblaze B2 / и т.п.
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=minecms-media
S3_ACCESS_KEY_ID=minecms
S3_SECRET_ACCESS_KEY=minecms-secret
# MinIO и path-style endpoint'ы (Cloudflare R2 и т.п.) требуют true. Для AWS S3 (virtual-hosted) — false.
S3_FORCE_PATH_STYLE=true
# Если bucket публично доступен по фиксированному префиксу — указываем его. Иначе server
# отдаёт signed URL'ы (TTL — 1 час). Раскомментируй и поправь под вашу схему.
# S3_PUBLIC_URL=http://127.0.0.1:9000/minecms-media
# Префикс ключей в bucket'е, чтобы держать медиа отдельно от других объектов.
S3_KEY_PREFIX=media
# Лимит размера одного загружаемого файла, в байтах. По умолчанию 25 MB.
MEDIA_MAX_FILE_SIZE=26214400
